@model List<RegistrosFinanceiros>


<div class="row mt-5">
    <a asp-action="index" class="btn btn-info w-100 mb-5">Voltar</a>

    <div class="col-md-4">
        <h2>Lucro</h2>
        <table class="table table-bordered">
            <thead class="table-success">
                <tr>
                    <th>Categoria</th>
                    <th>Transação</th>
                    <th>Valor</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count() > 0)
                {
                    @foreach (var registro in Model.Where(x => x.TransacaoNome == "Lucro").ToList())
                    {
                        <tr>
                            <td>@registro.CategoriaNome</td>
                            <td>@registro.TransacaoNome</td>
                            <td>R$ @registro.ValorCategoria</td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

    <div class="col-md-4">
        <h2>Despesas</h2>
        <table class="table table-bordered">
            <thead class="table-danger">
                <tr>
                    <th>Categoria</th>
                    <th>Transação</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() > 0)
                {
                    @foreach (var registro in Model.Where(x => x.TransacaoNome == "Despesa").ToList())
                    {

                    
                        <tr>
                            <td>@registro.CategoriaNome</td>
                            <td>@registro.TransacaoNome</td>
                            <td>R$ @registro.ValorCategoria</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-4">
        <h2>Total</h2>
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Lucro</th>
                    <th>Despesa</th>
                    <th>Diferença</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() > 0)
                {
                    <tr>
                        <td>R$ @Model.First().Lucros</td>
                        <td>R$ @Model.First().Despesas</td>
                        <td>R$ @Model.First().Diferenca</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

